# Supabase project settings (from `supabase status` locally, or the Supabase dashboard in prod)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production site URL (used for OG tags, redirects, webhook callbacks)
NEXT_PUBLIC_SITE_URL=https://aztrx.app

# Web Push (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Browser extension (from chrome://extensions after loading apps/extension/public unpacked)
NEXT_PUBLIC_EXTENSION_ID=

# Email via Resend (primary) or Gmail SMTP (fallback)
# Resend: https://resend.com → API Keys (free: 100/day)
RESEND_API_KEY=
# Gmail fallback: App Password from https://myaccount.google.com/apppasswords
EMAIL_FROM=
EMAIL_APP_PASSWORD=

# WhatsApp Cloud API (free: 1,000 msg/month)
# https://developers.facebook.com → App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Telegram Bot (unlimited, free)
# Message @BotFather → /newbot → get token
TELEGRAM_BOT_TOKEN=

# Polar.sh payments (Merchant of Record — handles tax/VAT/GST worldwide)
# https://polar.sh/dashboard/upstreamai → Settings → API
POLAR_ACCESS_TOKEN=
POLAR_PRO_MONTHLY_PRODUCT_ID=
POLAR_PRO_YEARLY_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# Supabase service role key (for admin operations — NEVER expose client-side)
# Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Admin access: comma-separated emails allowed to use /admin and /api/admin/*.
# If unset or empty, admin access is disabled for everyone (fail-closed).
ADMIN_EMAILS=

# AI assistant — built-in key powers 5 free questions/day for all users.
# Users can optionally add their own Anthropic/OpenAI/Gemini key in Settings
# for unlimited use. Desktop app users don't need any key at all — it uses
# their local Claude Code installation.
ANTHROPIC_API_KEY=

# Cron job secret — used to secure Vercel Cron endpoints (e.g. /api/cron/deadline-check).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Voice output (get a key at https://elevenlabs.io — Profile → API Keys).
# Without this, voice replies fall back to the browser's built-in TTS.
ELEVENLABS_API_KEY=
# Optional — a specific voice_id from your ElevenLabs Voice Library. Leave blank
# to auto-pick the account's first default premade voice.
ELEVENLABS_VOICE_ID=
